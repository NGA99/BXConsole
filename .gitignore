node_modules/
dist/
*.log
.DS_Store

# Runtime session data: recordings, the blob store, live webhook tokens, the
# relay's lock file. All of it is engagement data — see the README on handling.
sessions/*
!sessions/.gitkeep

# Relay configuration. PUBLIC_ORIGIN is the address payloads call home to, so
# a committed .env hands over the operator's infrastructure along with the code.
.env
.env.*
!.env.example

# TLS material, because the README tells people to put the relay behind a
# proxy and the keys end up next to the project.
*.pem
*.key
*.crt
*.p12
*.pfx

# Network exports. A HAR from the Network tab carries every header and body
# the run captured, which is the whole recording in one file.
*.har

# Generated by `npm run fixtures`, for the /stress/ target
examples/stress/big.json
examples/stress/big.js

# Local harness and editor state; .claude/launch.json is shared on purpose
.claude/settings.local.json
.vscode/
.idea/
*.swp
Thumbs.db
